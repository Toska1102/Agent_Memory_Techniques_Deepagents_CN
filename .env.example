# Required: any OpenAI-compatible endpoint used by all notebooks (via deepagents / ChatOpenAI)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# Optional: real embedding endpoint. Leave empty to use the built-in local fallback
# embeddings (deterministic word+n-gram hashing) when the gateway has no /embeddings.
# LLM_EMBEDDING_BASE_URL=https://api.example.com/v1
# LLM_EMBEDDING_API_KEY=your_embedding_api_key_here
# LLM_EMBEDDING_MODEL_NAME=text-embedding-3-small

# Optional: framework-specific notebooks
# ZEP_API_KEY=your_zep_api_key_here
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_neo4j_password_here
